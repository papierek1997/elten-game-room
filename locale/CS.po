msgstr "Šipky: procházení karet. Enter: zahrajte aktuální kartu nebo připravenou sadu karet a v případě potřeby zvolte ohlášení."

#: games/farkle.rb:55
msgid "Arrows: browse scoring combinations, Roll and Bank."
msgstr "Šipky: procházejte bodované kombinace a akce Hodit a Uložit body."

#: games/battleship.rb:68 games/checkers.rb:123 games/chess.rb:65 games/reversi.rb:57 games/tic_tac_toe.rb:36
msgid "Arrows: browse squares."
msgstr "Šipky: procházejte pole."

#: games/biblios.rb:74
msgid "Arrows: browse the available cards or actions."
