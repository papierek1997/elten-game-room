msgid "Ctrl+F4: read HTTP and available Communications ping."
msgstr "Ctrl+F4: přečtěte ping HTTP a také ping Communications, pokud je k dispozici."

msgid "Ctrl+F4: read the server ping."
msgstr "Ctrl+F4: přečíst odezvu serveru."

msgid "Ctrl+H switches numbered and chess notation, including movement announcements and displayed history. Ctrl+Shift+H rotates the board without renaming fields. In chat use /21 17 or /a3 b4 as appropriate for the chosen fields. A multiple capture is entered one jump at a time, just like Enter on the board."
msgstr "Ctrl+H přepíná číselnou a šachovou notaci, a to i v oznámeních tahů a zobrazené historii. Ctrl+Shift+H otočí hrací desku, aniž by se změnily názvy polí. V chatu použijte /21 17 nebo /a3 b4 podle zvoleného označení polí. Vícenásobné braní zadávejte po jednotlivých skocích, stejně jako pomocí klávesy Enter na hrací desce."

#: games/checkers.rb:130
msgid "Ctrl+H: switch numbered and chess notation."
msgstr "Ctrl+H: přepněte mezi číselnou a šachovou notací."

msgid "Ctrl+H: switch numbered and chess notation. Ctrl+Shift+H: rotate the view. In numbered mode, light squares sound but do not announce a field number."
msgstr "Ctrl+H: přepnout mezi číselným a šachovým zápisem. Ctrl+Shift+H: otočit pohled. V číselném režimu se světlá pole ozvou zvukem, ale číslo pole se nečte."

#: lib/game_history_navigation.rb:17
