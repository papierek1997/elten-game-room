msgid "Press Enter to begin."
msgstr "Začněte stisknutím Enteru."

#: games/tysiac.rb:557
msgid "Press Enter to bid."
msgstr "Stiskněte Enter pro podání nabídky."

#: lib/game_room_screens.rb:599
msgid "Press Enter to edit."
msgstr "Pro úpravu stiskněte Enter."

#: games/poker.rb:347
msgid "Press Enter to exchange the current card or the selected cards."
msgstr "Stisknutím Enter vyměňte aktuální kartu nebo vybrané karty."

