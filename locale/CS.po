#: games/taboo_ui.rb:60
msgid "Press Enter when everyone is ready."
msgstr "Až budou všichni připraveni, stiskněte Enter."

#: games/duck_racing_support/challenge_presentation.rb:261
msgid "Press Enter when you are ready."
msgstr "Až budete připraveni, stiskněte Enter."

#: games/generated/rulebooks/duck_racing.rb:127
msgid "Press Enter when you are ready. The point starts once both players have confirmed."
msgstr ""

msgid "Press F2 to lower and F3 to raise the selected Game Room sound volume."
msgstr "Stisknutím F2 snížíte a F3 zvýšíte hlasitost vybraného zvuku Game Room."

#: games/generated/rulebooks/bridge.rb:28
msgid "Press K to hear the contract, who declares it and how many tricks declarer has taken so far."
msgstr ""

#: games/generated/rulebooks/bridge.rb:24
msgid "Press L to hear the whole auction, or Ctrl+L to go through it call by call."
