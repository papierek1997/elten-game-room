msgid "Press B during your auction turn to open the list of legal bids, arranged in steps of 5, or to pass when passing is permitted. After taking the talon, use the Arrow keys and Enter to choose one card for each opponent, then press B to keep or raise the final contract."
msgstr "Během svého tahu v licitaci stiskněte B, čímž otevřete seznam povolených nabídek odstupňovaných po 5, nebo zvolte pas, je-li povolen. Po dobrání talonu vyberte šipkami a klávesou Enter jednu kartu pro každého soupeře a poté stiskněte B, chcete-li ponechat nebo zvýšit konečný závazek."

#: games/generated/rulebooks/duck_racing.rb:19
msgid "Press C to check your square, lap, feathers and any effects on your duck. S reads the race standings; T tells you whose turn it is or which challenge is being played."
msgstr ""

msgid "Press Ctrl+F1 to read the game rules."
msgstr "Stisknutím Ctrl+F1 si přečtete pravidla hry."

msgid "Press Ctrl+I to invite an online Elten user."
msgstr "Stisknutím Ctrl+I pozvete uživatele, který je právě online v Eltenu."

msgid "Press Ctrl+J to accept a game invitation."
msgstr "Stisknutím Ctrl+J přijmete pozvánku ke hře."

msgid "Press Ctrl+Left or Ctrl+Right to read the previous or next history message."
msgstr "Stisknutím Ctrl+Left nebo Ctrl+Right si přečtete předchozí nebo následující zprávu v historii."

#: lib/quiz_contributions/views.rb:63
msgid "Press Ctrl+N to add a question."
msgstr "Stiskněte Ctrl+N pro přidání otázky."

#: lib/quiz_contributions/views.rb:48
msgid "Press Ctrl+N to create a new set or add questions to an existing one."
msgstr "Stiskněte Ctrl+N pro vytvoření nové sady nebo přidání otázek do stávající."

#: games/generated/rulebooks/audio_ball.rb:37
msgid "Press Ctrl+P or choose Audio Ball settings from the table menu before or during a match. Choose Right (default) to hear your end on the right, or Left to hear it on the left. Left reverses the flight and preparation sounds: incoming balls travel from right to left and your attacks from left to right. This affects only what you hear. Your opponent's sound, the controls and the rules stay the same."
msgstr ""

msgid "Press Ctrl+Shift+I to invite someone from your contacts."
msgstr "Stisknutím Ctrl+Shift+I pozvete někoho ze svých kontaktů."

msgid "Press Ctrl+Shift+J to reject a game invitation."
msgstr "Stisknutím Ctrl+Shift+J odmítnete pozvánku ke hře."

msgid "Press Ctrl+Shift+Left or Ctrl+Shift+Right to read the first or last history message."
msgstr "Stisknutím Ctrl+Shift+Left nebo Ctrl+Shift+Right si přečtete první nebo poslední zprávu v historii."

#: games/generated/rulebooks/duck_racing.rb:55
msgid "Press Enter for one roll. You have ten seconds; if you do not roll, the game rolls for you when time runs out. The player with the highest result takes feathers equal to the difference from each opponent."
msgstr ""

msgid "Press Enter on Roll the die. If exactly one pawn can move, it moves automatically. If several pawns can move, the list shows only those choices together with their destinations; use the Arrow keys and Enter to choose."
msgstr "Stiskněte Enter na možnosti Hodit kostkou. Pokud se může pohnout právě jedna figurka, pohne se automaticky. Pokud se může pohnout více figurek, seznam zobrazí pouze tyto možnosti spolu s cílovými poli; vyberte šipkami a klávesou Enter."

#: lib/game_room_changelog.rb:314
msgid "Press Enter on a person in the table's Users list to open ELTEN's standard user menu, where you can send a message, call them or add them to your contacts."
msgstr ""

msgid "Press Enter on the pawn list to roll or to choose a displayed move. Press P for your pawn positions, Shift+P for the opponents' pawn positions, T for the turn and Ctrl+F1 for these rules."
msgstr "Na seznamu figurek stiskněte Enter, chcete-li hodit kostkou nebo vybrat zobrazený tah. Klávesou P přečtete pozice svých figurek, Shift+P pozice figurek soupeřů, T zjistíte, kdo je na tahu, a Ctrl+F1 otevřete tato pravidla."

msgid "Press Enter on the pawn list to roll. If exactly one pawn can move, it moves automatically. If several pawns can move, the list shows only those choices together with their destinations; use the Arrow keys and Enter to choose."
msgstr "Stiskněte Enter v seznamu figurek a hoďte kostkou. Pokud se může pohnout právě jedna figurka, pohne se automaticky. Pokud se může pohnout více figurek, seznam zobrazí pouze tyto možnosti spolu s cílovými poli; vyberte šipkami a klávesou Enter."

#: lib/game_room_screens.rb:599
msgid "Press Enter to assign."
msgstr "Pro přiřazení stiskněte Enter."

