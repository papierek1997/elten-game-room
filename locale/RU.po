msgstr "Порядок карт: обычный; туз — самая сильная карта, а два — самые слабые."

#: games/scientific_war.rb:829
msgid "Card order: reversed; two is the strongest card and ace the weakest."
msgstr "Порядок карт: обратный; два — самая сильная карта, туз — слабая."

