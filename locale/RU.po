msgstr "C: прочитайте карточку, если ваша роль может её увидеть."

#: games/generated/rulebooks/war.rb:23
msgid "C: read the cards on the table, your own first, then each opponent's."
msgstr "C: сначала читайте карты на столе, сначала свои, потом карты каждого соперника."

#: games/generated/rulebooks/bouillabaisse.rb:32 games/generated/rulebooks/bridge.rb:84
msgid "C: read the current trick."
msgstr "C: текущая взятка."

msgid "C: read the current turn total."
msgstr "C: прочитать текущий общий счёт хода."

#: games/generated/rulebooks/scrabble.rb:35
msgid "C: read the rack."
msgstr "C: просмотреть держатель карт."

msgid "C: read the rack. 1–7: read individual rack positions without placing a tile. I: cycle receipt, alphabetic and vowel-first rack order after clearing a draft. Y: preview words and points. L: browse played words."
msgstr "C: читать стойку. 1–7: читать отдельные позиции стойки без размещения фишки. I: цикл квитанции, алфавитный и гласный порядок стойки после очистки чёрновика. Y: предварительный просмотр слов и очков. L: просмотр сыгранных слов."

#: games/generated/rulebooks/ninety_nine.rb:30
msgid "C: read the shared total."
msgstr "C: прочитать общую сумму."

#: games/generated/rulebooks/makao.rb:39
