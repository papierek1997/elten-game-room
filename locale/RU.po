msgstr "2 напрямую добавляет два очка к вашему накопленному счёту. Это оставляет текущий ход неизменным и не заканчивает ход. Эти два очка остаются вашими, даже если вы выбросите 1 позже."

#: games/tysiac.rb:189
msgid "2 cards"
msgstr "2 карты"

#: games/categories.rb:374
msgid "20 seconds remain."
msgstr "Осталось 20 секунд."

#: games/war.rb:53
msgid "24 cards, from nine to ace"
msgstr "24 карты, от девятки до туза"

#: games/generated/rulebooks/axel_pong.rb:58
msgid "2: as an observer, listen from the second player's perspective."
msgstr "2: Как наблюдатель, слушайте с точки зрения второго игрока."

#: games/generated/rulebooks/taboo.rb:34
msgid "2: read forbidden word 1, if your role may see the card."
msgstr "2: прочитайте запретное слово 1, если ваша роль может увидеть карту."

#: games/generated/rulebooks/poker.rb:59
msgid "2: read private card 2."
msgstr "2: прочитать закрытую карту 2."

#: games/generated/rulebooks/scrabble.rb:45
msgid "2: read rack position 2, without placing it."
msgstr "2: прочитать фишку на позиции 2, не выкладывая её."

#: games/generated/rulebooks/ludo.rb:25
