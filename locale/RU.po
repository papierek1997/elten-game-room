#: games/generated/rulebooks/makao.rb:47 games/generated/rulebooks/ninety_nine.rb:35 games/generated/rulebooks/rummy.rb:61 games/generated/rulebooks/spades.rb:41 games/generated/rulebooks/three_five_eight.rb:36 games/generated/rulebooks/tysiac.rb:53 games/generated/rulebooks/uno.rb:51
