msgstr "C: прочитать карту на столе и объявление."

#: games/generated/rulebooks/scopa.rb:37
msgid "C: read the table cards."
msgstr ""

#: games/generated/rulebooks/uno.rb:42
msgid "C: read the top card."
msgstr "C: прочитать верхнюю карту."

#: games/generated/rulebooks/spades.rb:32 games/generated/rulebooks/three_five_eight.rb:28 games/generated/rulebooks/tysiac.rb:45
msgid "C: read the trick cards."
msgstr "C: прочитать карты взятки."

#: games/generated/rulebooks/farkle.rb:26
msgid "C: read turn points and the required minimum."
msgstr "C: прочитать очки за текущий ход и необходимый минимум."

#: games/generated/rulebooks/monopoly.rb:50
msgid "C: read your cash."
msgstr "C: прочитать свои наличные."

#: games/generated/rulebooks/axel_pong.rb:54
msgid "C: read your paddle position, or the observed player's position when watching."
msgstr "C: прочитать положение своей ракетки или ракетки выбранного игрока при наблюдении."

#: games/axel_pong.rb:286
msgid "C: read your paddle position."
msgstr "C: прочитать положение своей ракетки."

msgid "C: table card and declaration. G: pending penalty. D: your hand. E: card counts. T: whose turn it is."
msgstr "C: настольная карта и объявление. G: ожидающий штраф. D: ваша рука. E: счёт карт. T: чья очередь."

