msgstr "Техническое поражение до начала матча."

#: lib/tournaments/server_forfeit_screen.rb:181 lib/tournaments/server_forfeit_screen.rb:205 lib/tournaments/server_forfeit_screen.rb:215
msgid "Forfeit consequences"
msgstr "Последствия технического поражения"

